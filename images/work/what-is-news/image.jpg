:root :where(.wp-block-prc-block-subtitle){font-family: var(--wp--preset--font-family--serif);font-style: italic;font-weight: 500;}
:root :where(.wp-block-prc-block-table){font-family: var(--wp--preset--font-family--sans-serif);font-size: 14px;line-height: 1.5;}
:root :where(.wp-block-prc-block-table-of-contents){color: var(--wp--preset--color--ui-text-color);font-family: var(--wp--preset--font-family--sans-serif);margin-top: 1rem;margin-bottom: 1rem;}
:root :where(.wp-block-prc-block-table-of-contents a:where(:not(.wp-element-button))){color: var(--wp--preset--color--ui-text-color);}
