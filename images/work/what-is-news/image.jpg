.wp-block-navigation-link a{text-decoration:none!important}.wp-block-navigation-link.current-menu-item{font-weight:700}.wp-block-navigation.is-style-default{width:auto}.wp-block-navigation.is-style-default .wp-block-navigation-link a.wp-block-navigation-item__content{color:var(--wp--preset--color--link-color)}.wp-block-navigation.is-style-default .wp-block-navigation-link a:hover>.wp-block-navigation-item__label{text-decoration:underline!important}.wp-block-navigation.is-style-divided-links{gap:0;line-height:1em;width:auto}.wp-block-navigation.is-style-divided-links .wp-block-navigation-link a.wp-block-navigation-item__content{color:var(--wp--preset--color--link-color);padding:0!important}.wp-block-navigation.is-style-divided-links .wp-block-navigation-link a:hover>.wp-block-navigation-item__label{text-decoration:underline!important}.wp-block-navigation.is-style-divided-links .wp-block-navigation-link .wp-block-navigation-item__label{border-right:1px solid #000;display:inline-block;padding:0 .5em}.wp-block-navigation.is-style-divided-links .wp-block-navigation-link:last-of-type .wp-block-navigation-item__label{border-right:none!important;padding-right:0}.wp-block-navigation.is-style-divided-links .has-text-color.has-ui-white-color .wp-block-navigation-item__label{border-right-color:var(--wp--preset--color--ui-white)!important}.wp-block-navigation.is-style-pills .wp-block-navigation__container{display:flex;flex-wrap:nowrap;overflow-x:auto;overflow-x:overlay}.wp-block-navigation.is-style-pills .wp-block-navigation-item{border:1px solid #eaeaea;border-radius:3px;flex-shrink:0;padding:.7857142857em 1.5em;text-align:center;text-decoration:none;transition:opacity .1s ease,background-color .1s ease,color .1s ease,box-shadow .1s ease,background .1s ease}.wp-block-navigation.is-style-pills .wp-block-navigation.is-style-pills .wp-block-navigation-item:hover{background-color:#eaeaea}.wp-block-navigation.is-style-mega-menu{position:relative;width:100%}.wp-block-navigation.is-style-mega-menu .wp-block-navigation__container{width:100%}.wp-block-navigation.is-style-mega-menu .wp-block-navigation-item{display:flex;flex-grow:1}.wp-block-navigation.is-style-mega-menu .wp-block-navigation-item.current-menu-item{font-weight:700}.wp-block-navigation.is-style-mega-menu .wp-block-navigation-item .wp-block-navigation-item__content{display:block;flex-grow:1;padding:1em!important;text-align:center}.ot-sdk-show-settings.wp-block-navigation-link{cursor:pointer;text-decoration:none}.ot-sdk-show-settings.wp-block-navigation-link:hover{text-decoration:underline}

