<script id="wp-consent-api-js" src="https://www.pewresearch.org/wp-content/plugins/wp-consent-api/assets/js/wp-consent-api.min.js?ver=2.0.1"></script>
<script id="wp-consent-api-js-after">
		(function() {
			var categoryMap = {
				"functional": 0,
				"statistics-anonymous": 1,
				"statistics": 1,
				"preferences": 3,
				"marketing": 2
			};
			var registeredServices = {"meta":{"label":"Meta (Facebook) Pixel","category":"marketing"},"pinterest":{"label":"Pinterest Tag","category":"marketing"},"linkedin":{"label":"LinkedIn Insight Tag","category":"marketing"},"reddit":{"label":"Reddit Pixel","category":"marketing"}};

			function readServiceConsent(slug) {
				if (typeof wp_has_service_consent === "function") {
					return wp_has_service_consent(slug);
				}
				var info = registeredServices[slug];
				if (info && typeof wp_has_consent === "function") {
					return wp_has_consent(info.category);
				}
				return false;
			}

			function writeServiceConsent(slug, allowed) {
				if (typeof wp_set_service_consent === "function") {
					wp_set_service_consent(slug, !!allowed);
				}
			}

			document.addEventListener("DOMContentLoaded", function() {
				if (typeof wp_has_consent !== "function") {
					return;
				}

				var categories = ["functional", "statistics-anonymous", "statistics", "preferences", "marketing"];
				var hasAnyConsent = false;

				categories.forEach(function(category) {
					if (wp_has_consent(category)) {
						hasAnyConsent = true;
					}
				});

				if (window.prcCookieBanner && hasAnyConsent) {
					window.prcCookieBanner.hide();
				}
			});

			document.addEventListener("prc_cookie_consent_updated", function(e) {
				if (typeof wp_set_consent !== "function") {
					return;
				}

				var preferences = e.detail.preferences || {};
				var servicePreferences = e.detail.servicePreferences || {};

				Object.keys(preferences).forEach(function(categoryIndex) {
					var allowed = preferences[categoryIndex];
					var wpCategory = "";

					switch(parseInt(categoryIndex, 10)) {
						case 0:
							wpCategory = "functional";
							break;
						case 1:
							wpCategory = "statistics";
							break;
						case 2:
							wpCategory = "marketing";
							break;
						case 3:
							wpCategory = "preferences";
							break;
					}

					if (wpCategory) {
						wp_set_consent(wpCategory, allowed ? "allow" : "deny");
					}
				});

				Object.keys(servicePreferences).forEach(function(slug) {
					writeServiceConsent(slug, servicePreferences[slug]);
				});

				Object.keys(registeredServices).forEach(function(slug) {
					if (Object.prototype.hasOwnProperty.call(servicePreferences, slug)) {
						return;
					}
					var category = registeredServices[slug].category;
					var categoryIndex = categoryMap[category];
					if (categoryIndex !== undefined && preferences[categoryIndex] !== undefined) {
						writeServiceConsent(slug, !!preferences[categoryIndex]);
					}
				});
			});

			document.addEventListener("wp_listen_for_consent_change", function(e) {
				if (!window.prcCookieBanner) {
					return;
				}

				var changedConsentCategory = e.detail;

				for (var category in changedConsentCategory) {
					if (changedConsentCategory.hasOwnProperty(category) && categoryMap.hasOwnProperty(category)) {
						var categoryIndex = categoryMap[category];
						var value = changedConsentCategory[category] === "allow";

						if (window.prcCookieBanner.getState) {
							var state = window.prcCookieBanner.getState();
							if (state && state.cookiePreferences) {
								state.cookiePreferences[categoryIndex] = value;
							}
						}
					}
				}
			});

			document.addEventListener("wp_consent_api_status_change_service", function(e) {
				if (!window.prcCookieBanner || !e.detail) {
					return;
				}

				var slug = e.detail.service;
				var allowed = !!e.detail.value;

				if (window.prcCookieBanner.getState) {
					var bannerState = window.prcCookieBanner.getState();
					if (bannerState && bannerState.servicePreferences) {
						bannerState.servicePreferences[slug] = allowed;
					}
				}
			});
		})();
		
//# sourceURL=wp-consent-api-js-after
</script>
