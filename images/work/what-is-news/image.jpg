var consent_api = {"consent_type":"optin","waitfor_consent_hook":"","cookie_expiration":"30","cookie_prefix":"wp_consent","services":[{"name":"PRC Quiz Builder","category":"functional"},{"name":"PRC User Accounts","category":"functional"},{"name":"PRC User Survey Interaction","category":"functional"},{"name":"PRC Last Visited","category":"functional"},{"name":"Google Analytics","category":"statistics"},{"name":"Google Analytics 4","category":"statistics"},{"name":"Facebook","category":"marketing"},{"name":"meta","category":"marketing"},{"name":"pinterest","category":"marketing"},{"name":"linkedin","category":"marketing"},{"name":"reddit","category":"marketing"},{"name":"Parsely","category":"statistics"},{"name":"Nelio","category":"statistics"},{"name":"WordPress VIP","category":"functional"},{"name":"","category":"statistics"},{"name":"Reddit","category":"marketing"},{"name":"Google Adsense","category":"marketing"},{"name":"Pinterest","category":"marketing"}]};
